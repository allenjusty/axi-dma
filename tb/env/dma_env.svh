// dma_irq_monitor: irq must equal |(INT_STATUS & INT_ENABLE) as predicted by the reference
// model (not the register-model mirror, which never sees hardware setting a bit).
class dma_irq_monitor extends uvm_component;
    `uvm_component_utils(dma_irq_monitor)
    virtual dma_irq_if vif;
    dma_ref_model      ref_m;
    int                n_checks;

    function new(string name, uvm_component parent);
        super.new(name, parent);
    endfunction

    function void build_phase(uvm_phase phase);
        if (!uvm_config_db#(virtual dma_irq_if)::get(this, "", "irq_vif", vif)) `uvm_fatal("NOVIF", "irq_vif not set")
    endfunction

    task run_phase(uvm_phase phase);
        forever begin
            @(negedge vif.clk);
            #1;
            if (vif.rst_n && ref_m.settled()) begin
                n_checks++;
                if (vif.irq !== ref_m.exp_irq())
                    `uvm_error("IRQ", $sformatf("irq=%b, expected %b (INT_STATUS=%b INT_ENABLE=%b)",
                                                vif.irq, ref_m.exp_irq(), ref_m.int_status, ref_m.r_int_enable))
            end
        end
    endtask

    function void report_phase(uvm_phase phase);
        `uvm_info("IRQ", $sformatf("irq checked on %0d cycles", n_checks), UVM_LOW)
    endfunction
endclass

// ------------------------------------------------------------------ environment
class dma_env extends uvm_env;
    `uvm_component_utils(dma_env)

    dma_env_cfg                   cfg;
    apb_agent                     apb;
    axi_slave_agent               axi;
    dma_regs                      regmodel;
    apb_reg_adapter               adapter;
    uvm_reg_predictor #(apb_item) predictor;
    dma_ref_model                 ref_m;
    dma_scoreboard                sb;
    dma_irq_monitor               irq_mon;
    dma_coverage                  cov;

    function new(string name, uvm_component parent);
        super.new(name, parent);
    endfunction

    function void build_phase(uvm_phase phase);
        if (!uvm_config_db#(dma_env_cfg)::get(this, "", "cfg", cfg)) `uvm_fatal("NOCFG", "dma_env_cfg not set")
        uvm_config_db#(axi_slave_cfg)::set(this, "axi.*", "axi_cfg", cfg.axi_cfg);
        uvm_config_db#(axi_mem_model)::set(this, "axi.*", "axi_mem", cfg.mem);

        apb     = apb_agent::type_id::create("apb", this);
        axi     = axi_slave_agent::type_id::create("axi", this);
        ref_m   = dma_ref_model::type_id::create("ref_m", this);
        sb      = dma_scoreboard::type_id::create("sb", this);
        irq_mon = dma_irq_monitor::type_id::create("irq_mon", this);
        cov     = dma_coverage::type_id::create("cov", this);

        // Register model (generated by PeakRDL-uvm), frontdoor access through APB
        regmodel = new("regmodel");
        regmodel.build();
        regmodel.lock_model();
        adapter   = apb_reg_adapter::type_id::create("adapter");
        predictor = uvm_reg_predictor#(apb_item)::type_id::create("predictor", this);
    endfunction

    function void connect_phase(uvm_phase phase);
        regmodel.default_map.set_sequencer(apb.sqr, adapter);
        regmodel.default_map.set_auto_predict(0);
        predictor.map     = regmodel.default_map;
        predictor.adapter = adapter;
        apb.mon.ap.connect(predictor.bus_in);

        ref_m.cfg = cfg;  ref_m.cov = cov;
        sb.cfg    = cfg;  sb.cov    = cov;  sb.ref_m = ref_m;
        irq_mon.ref_m = ref_m;
        apb.mon.ap.connect(ref_m.apb_imp);
        ref_m.xfer_ap.connect(sb.xfer_imp);
        axi.mon.ap.connect(sb.axi_imp);
    endfunction
endclass
